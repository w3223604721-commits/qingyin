.insights-page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding-bottom: 40rpx;
}

.insights-header {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark, #4F46E5));
  padding: 40rpx 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(255,255,255,0.2);
  color: #fff;
  border: none;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.btn-back::after { border: none; }

.back-icon { font-size: 36rpx; line-height: 1; }

.insights-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
}

/* Tab 标签栏 */
.insight-tabs {
  display: flex;
  margin: 20rpx 28rpx;
  background: var(--bg-secondary);
  border-radius: 14rpx;
  padding: 6rpx;
}

.insight-tab {
  flex: 1;
  padding: 14rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: none;
  border: none;
  border-radius: 10rpx;
  font-weight: 500;
}

.insight-tab::after { border: none; }

.insight-tab.active {
  background: #fff;
  color: var(--primary);
  font-weight: 700;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

/* 图表内容区 */
.insight-chart-area {
  margin: 0 28rpx;
}

.chart-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.chart-title {
  text-align: center;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
}

.chart-subtitle {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 400;
}

/* 柱状图 */
.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 320rpx;
  padding: 0 4rpx;
}

.bar-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-fill {
  width: 100%;
  max-width: 48rpx;
  background: linear-gradient(to top, var(--primary), var(--primary-light, #A5B4FC));
  border-radius: 6rpx 6rpx 0 0;
  min-height: 4rpx;
  position: relative;
  transition: height 0.4s ease;
}

.bar-value {
  position: absolute;
  top: -28rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: var(--primary);
  font-weight: 700;
}

.bar-label {
  font-size: 18rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  white-space: nowrap;
}

/* 季节分布条 */
.season-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.season-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.season-label {
  width: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.season-bar-bg {
  flex: 1;
  height: 28rpx;
  background: var(--bg-secondary);
  border-radius: 14rpx;
  overflow: hidden;
}

.season-bar-fill {
  height: 100%;
  background: linear-gradient(to right, var(--primary), var(--primary-light, #A5B4FC));
  border-radius: 14rpx;
  transition: width 0.5s ease;
}

.season-count {
  width: 60rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.season-summary {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-primary);
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.season-highlight {
  color: var(--primary);
  font-weight: 800;
}

/* 标签统计条 */
.tag-bars {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tag-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag-label {
  width: 120rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-bar-bg {
  flex: 1;
  height: 24rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
  overflow: hidden;
}

.tag-bar-fill {
  height: 100%;
  background: linear-gradient(to right, var(--primary), var(--primary-light, #A5B4FC));
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.tag-count {
  width: 60rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.tag-summary {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}