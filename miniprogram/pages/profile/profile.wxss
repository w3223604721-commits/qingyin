.profile-page {
  min-height: 100vh;
  padding-bottom: 128rpx;
  background: var(--bg-primary);
}

/* 头像与档案 */
.profile-header-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark, #4F46E5));
  padding: 40rpx 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
}

.profile-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.4);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 900;
  color: #fff;
}

.avatar-edit-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.profile-info {
  flex: 1;
  color: #fff;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
}

.profile-bio {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
  margin-top: 4rpx;
}

.profile-stats {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.7;
}

.dot {
  margin: 0 8rpx;
}

.btn-edit-profile {
  position: absolute;
  top: 40rpx;
  right: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 22rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.btn-edit-profile::after { border: none; }

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 12rpx;
  margin: 0 28rpx 16rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--primary);
  display: block;
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

/* 数据洞察 */
.insight-section {
  margin: 0 28rpx 16rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.insight-toggle-btn {
  font-size: 24rpx;
  color: var(--primary);
  background: none;
  border: none;
  padding: 4rpx 12rpx;
}

.insight-toggle-btn::after { border: none; }

.insight-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.insight-card {
  flex: 1 1 calc(50% - 6rpx);
  min-width: calc(50% - 6rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 12rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}

.insight-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.insight-info {
  display: flex;
  flex-direction: column;
}

.insight-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.insight-value {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin: 2rpx 0;
}

.insight-sub {
  font-size: 18rpx;
  color: var(--text-muted);
  line-height: 1.3;
}

/* 功能列表 */
.profile-menu {
  margin: 16rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-arrow {
  margin-left: auto;
  font-size: 32rpx;
  color: var(--text-muted);
}

/* 头像上传 */
.avatar-upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.avatar-preview-lg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid var(--primary);
}

.avatar-preview-img {
  width: 100%;
  height: 100%;
}

.avatar-preview-text {
  font-size: 60rpx;
  font-weight: 900;
  color: var(--primary);
}

.avatar-upload-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}
