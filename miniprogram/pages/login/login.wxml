<view class="login-page">
  <view class="login-header">
    <view class="header-bg-circle circle-1"></view>
    <view class="header-bg-circle circle-2"></view>
    <view class="header-bg-circle circle-3"></view>
  </view>
  <view class="login-body">
    <view class="logo-area">
      <view class="logo-icon-wrap"><text class="logo-icon">✈️</text></view>
      <text class="logo-title">轻印</text>
      <text class="logo-subtitle">记录每一段旅程，留下美好足迹</text>
    </view>
    <view class="form-section" wx:if="{{!loggingIn}}">
      <button class="btn-wechat-login {{!agreePrivacy ? 'disabled' : ''}}" disabled="{{!agreePrivacy || loggingIn}}" bindtap="onWechatLogin">
        <text class="wechat-logo">微信</text><text>微信快捷登录</text>
      </button>
      <view class="divider-row"><view class="divider-line"></view><text class="divider-text">或</text><view class="divider-line"></view></view>
      <view class="input-group">
        <view class="input-wrap"><text class="input-icon">👤</text><input class="form-input" type="text" placeholder="用户名 / 手机号" maxlength="30" value="{{inputAccount}}" bindinput="onAccountInput"/></view>
        <view class="input-wrap"><text class="input-icon">🔒</text><input class="form-input" type="text" password="{{!showPassword}}" placeholder="密码" maxlength="20" value="{{inputPassword}}" bindinput="onPasswordInput"/><view class="pwd-toggle" bindtap="togglePassword"><text>{{showPassword ? '🙈' : '👁'}}</text></view></view>
      </view>
      <button class="btn-form-login {{!agreePrivacy ? 'disabled' : ''}} {{loggingIn ? 'logging' : ''}}" disabled="{{!agreePrivacy || loggingIn}}" bindtap="handleLogin">{{loggingIn ? '登录中...' : '登 录'}}</button>
      <view class="bottom-links"><text class="link-text" bindtap="openUserAgreement">忘记密码？</text><text class="link-divider">|</text><text class="link-text" bindtap="showRegisterTips">创建账号</text></view>
      <view class="agreement" catchtap="toggleAgreement">
        <view class="check-box {{agreePrivacy ? 'checked' : ''}}"><text wx:if="{{agreePrivacy}}" class="check-mark">✓</text></view>
        <text class="agree-text">我已阅读并同意<text class="agree-link" catchtap="openUserAgreement">《用户协议》</text>和<text class="agree-link" catchtap="openPrivacyPolicy">《隐私政策》</text></text>
      </view>
    </view>
    <view class="loading-section" wx:if="{{loggingIn}}"><view class="loading-spinner"></view><text class="loading-text">正在连接...</text></view>
  </view>
  <view class="footer-brand"><text class="footer-text">轻印 · 旅行记忆</text></view>
</view>