/* 登录页面 - 轻印旅行记忆 · 全新设计 */

page {
  background: linear-gradient(180deg, #f0f4ff 0%, #ffffff 45%);
  min-height: 100vh;
}

.login-page {
  min-height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ─── 顶部装饰背景 ─── */
.login-header {
  position: relative;
  height: 380rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.header-bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.12;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #6366f1;
  top: -160rpx;
  right: -80rpx;
}

.circle-2 {
  width: 240rpx;
  height: 240rpx;
  background: #818cf8;
  top: 60rpx;
  left: -60rpx;
}

.circle-3 {
  width: 120rpx;
  height: 120rpx;
  background: #a5b4fc;
  top: 200rpx;
  right: 100rpx;
}

/* ─── 主内容区 ─── */
.login-body {
  flex: 1;
  padding: 0 56rpx 40rpx;
  margin-top: -180rpx;
  display: flex;
  flex-direction: column;
}

/* ─── Logo 区域 ─── */
.logo-area {
  text-align: center;
  margin-bottom: 64rpx;
}

.logo-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(99, 102, 241, 0.35);
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 56rpx;
}

.logo-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #1e1b4b;
  letter-spacing: 10px;
  margin-bottom: 10rpx;
}

.logo-subtitle {
  display: block;
  font-size: 25rpx;
  color: #94a3b8;
  letter-spacing: 2px;
}

/* ─── 表单区域 ─── */
.form-section {
  width: 100%;
}

/* 微信一键登录按钮（主推）*/
.btn-wechat-login {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #07C160, #06ae56);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.3);
  transition: all 0.2s ease;
}

.btn-wechat-login::after { border: none; }

.btn-wechat-login.disabled {
  opacity: 0.4;
  box-shadow: none;
}

.wechat-logo {
  font-size: 30rpx;
  font-weight: 800;
}

/* 分割线 */
.divider-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 36rpx 0 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e2e8f0;
}

.divider-text {
  font-size: 24rpx;
  color: #cbd5e1;
}

/* 输入组 */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 96rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input-wrap:focus-within {
  border-color: #6366f1;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.08);
}

.input-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 100%;
  font-size: 29rpx;
  color: #1e293b;
  background: transparent;
  border: none;
}

.pwd-toggle {
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* 表单登录按钮 */
.btn-form-login {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: 6px;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(99, 102, 241, 0.3);
  transition: all 0.2s ease;
  margin-top: 8rpx;
}

.btn-form-login::after { border: none; }

.btn-form-login.disabled {
  opacity: 0.38;
  box-shadow: none;
  background: #c7d2fe;
}

.btn-form-login.logging {
  opacity: 0.78;
}

/* 底部链接 */
.bottom-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 28rpx;
  margin-bottom: 24rpx;
}

.link-text {
  font-size: 26rpx;
  color: #64748b;
}

.link-divider {
  font-size: 24rpx;
  color: #cbd5e1;
}

/* 协议区域 */
.agreement {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 0 8rpx;
}

.check-box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  transition: all 0.2s;
  background: #fff;
}

.check-box.checked {
  background: #6366f1;
  border-color: #6366f1;
}

.check-mark {
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1;
}

.agree-text {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.55;
  flex: 1;
}

.agree-link {
  color: #6366f1;
  font-weight: 600;
}

/* ─── 加载状态 ─── */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 140rpx 0 60rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #e2e8f0;
  border-top-color: #6366f1;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #64748b;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ─── 底部品牌 ─── */
.footer-brand {
  text-align: center;
  padding: 32rpx 0 48rpx;
  flex-shrink: 0;
}

.footer-text {
  font-size: 24rpx;
  color: #cbd5e1;
  letter-spacing: 2px;
}

/* ─── 手机号弹窗 ─── */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx 60rpx;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
}

.modal-close {
  font-size: 40rpx;
  color: #94a3b8;
  padding: 8rpx;
  line-height: 1;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.modal-input {
  width: 100%;
  height: 92rpx;
  padding: 0 28rpx;
  font-size: 29rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: #fafbfc;
  color: #1e293b;
  box-sizing: border-box;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-input {
  flex: 1;
}

.btn-code {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 26rpx;
  color: #6366f1;
  background: rgba(99, 102, 241, 0.06);
  border: 2rpx solid #6366f1;
  border-radius: 20rpx;
  white-space: nowrap;
  text-align: center;
}

.btn-code::after { border: none; }
.btn-code.disabled {
  color: #94a3b8;
  border-color: #e2e8f0;
  background: #f8fafc;
}

.modal-foot {
  margin-top: 32rpx;
}

.btn-modal-submit {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}

.btn-modal-submit::after { border: none; }
.btn-modal-submit.disabled {
  background: #c7d2fe;
}
