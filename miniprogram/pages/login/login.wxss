page { background: linear-gradient(180deg, #f0f4ff 0%, #ffffff 45%); min-height: 100vh; }
.login-page { min-height: 100vh; position: relative; display: flex; flex-direction: column; overflow: hidden; }
.login-header { position: relative; height: 380rpx; flex-shrink: 0; overflow: hidden; }
.header-bg-circle { position: absolute; border-radius: 50%; opacity: 0.12; }
.circle-1 { width: 400rpx; height: 400rpx; background: #6366f1; top: -160rpx; right: -80rpx; }
.circle-2 { width: 240rpx; height: 240rpx; background: #818cf8; top: 60rpx; left: -60rpx; }
.circle-3 { width: 120rpx; height: 120rpx; background: #a5b4fc; top: 200rpx; right: 100rpx; }
.login-body { flex: 1; padding: 0 56rpx 40rpx; margin-top: -180rpx; display: flex; flex-direction: column; }
.logo-area { text-align: center; margin-bottom: 64rpx; }
.logo-icon-wrap { width: 128rpx; height: 128rpx; border-radius: 36rpx; background: linear-gradient(135deg, #6366f1, #8b5cf6); display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 40rpx rgba(99, 102, 241, 0.35); margin-bottom: 24rpx; }
.logo-icon { font-size: 56rpx; }
.logo-title { display: block; font-size: 52rpx; font-weight: 800; color: #1e1b4b; letter-spacing: 10px; margin-bottom: 10rpx; }
.logo-subtitle { display: block; font-size: 25rpx; color: #94a3b8; letter-spacing: 2px; }
.form-section { width: 100%; }
.btn-wechat-login { width: 100%; height: 96rpx; border-radius: 48rpx; background: linear-gradient(135deg, #07C160, #06ae56); color: #fff; font-size: 32rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 12rpx; border: none; box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.3); }
.btn-wechat-login::after { border: none; }
.btn-wechat-login.disabled { opacity: 0.4; box-shadow: none; }
.wechat-logo { font-size: 30rpx; font-weight: 800; }
.divider-row { display: flex; align-items: center; gap: 20rpx; margin: 36rpx 0 32rpx; }
.divider-line { flex: 1; height: 1rpx; background: #e2e8f0; }
.divider-text { font-size: 24rpx; color: #cbd5e1; }
.input-group { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 28rpx; }
.input-wrap { position: relative; display: flex; align-items: center; background: #fff; border: 2rpx solid #e2e8f0; border-radius: 20rpx; padding: 0 24rpx; height: 96rpx; box-sizing: border-box; }
.input-wrap:focus-within { border-color: #6366f1; box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.08); }
.input-icon { font-size: 28rpx; margin-right: 16rpx; flex-shrink: 0; }
.form-input { flex: 1; height: 100%; font-size: 29rpx; color: #1e293b; background: transparent; border: none; }
.pwd-toggle { padding: 8rpx 12rpx; font-size: 26rpx; flex-shrink: 0; }
.btn-form-login { width: 100%; height: 96rpx; border-radius: 48rpx; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; font-size: 33rpx; font-weight: 700; letter-spacing: 6px; border: none; box-shadow: 0 8rpx 28rpx rgba(99, 102, 241, 0.3); margin-top: 8rpx; }
.btn-form-login::after { border: none; }
.btn-form-login.disabled { opacity: 0.38; box-shadow: none; background: #c7d2fe; }
.btn-form-login.logging { opacity: 0.78; }
.bottom-links { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 28rpx; margin-bottom: 24rpx; }
.link-text { font-size: 26rpx; color: #64748b; }
.link-divider { font-size: 24rpx; color: #cbd5e1; }
.agreement { display: flex; align-items: flex-start; gap: 14rpx; padding: 0 8rpx; }
.check-box { width: 34rpx; height: 34rpx; border-radius: 8rpx; border: 2rpx solid #d1d5db; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2rpx; background: #fff; }
.check-box.checked { background: #6366f1; border-color: #6366f1; }
.check-mark { color: #fff; font-size: 22rpx; font-weight: bold; line-height: 1; }
.agree-text { font-size: 24rpx; color: #94a3b8; line-height: 1.55; flex: 1; }
.agree-link { color: #6366f1; font-weight: 600; }
.loading-section { display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding: 140rpx 0 60rpx; }
.loading-spinner { width: 56rpx; height: 56rpx; border: 5rpx solid #e2e8f0; border-top-color: #6366f1; border-radius: 50%; animation: spin 0.75s linear infinite; }
.loading-text { font-size: 28rpx; color: #64748b; }
@keyframes spin { to { transform: rotate(360deg); } }
.footer-brand { text-align: center; padding: 32rpx 0 48rpx; flex-shrink: 0; }
.footer-text { font-size: 24rpx; color: #cbd5e1; letter-spacing: 2px; }