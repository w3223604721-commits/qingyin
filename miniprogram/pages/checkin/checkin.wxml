<view class="checkin-page">
  <view class="checkin-map-wrap">
    <map id="checkinMap" class="checkin-map" latitude="{{mapCenter.lat}}" longitude="{{mapCenter.lng}}" scale="{{mapScale}}" markers="{{markers}}" polyline="{{polylines}}" circles="{{circles}}" show-location="{{showUserLocation}}" bindmarkertap="onMarkerTap" bindregionchange="onRegionChange" bindtap="onMapTap" style="width:100%;height:100%;"></map>
    <view class="map-right-toolbar" style="top: {{statusBarHeight + 12}}px;">
      <button class="map-tool-btn" bindtap="locateUser"><text class="tool-icon">📍</text></button>
      <button class="map-tool-btn" bindtap="openCheckinModal"><text class="tool-icon">➕</text></button>
      <button class="map-tool-btn" bindtap="toggleReport"><text class="tool-icon">📊</text></button>
    </view>
    <view class="footprint-bar">
      <view class="footprint-status {{tracking ? 'tracking' : ''}}"><view class="fp-dot"></view><text>{{tracking ? '记录中...' : '就绪'}}</text></view>
      <button class="fp-track-btn {{tracking ? 'recording' : ''}}" bindtap="toggleTracking"><text>{{tracking ? '⏹ 停止' : '▶ 开始记录'}}</text></button>
      <view class="fp-info"><text class="fp-count">{{footprintCount}}</text> 个足迹点</view>
    </view>
  </view>
  <custom-tab-bar selected="{{1}}"></custom-tab-bar>
</view>