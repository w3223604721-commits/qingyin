<!-- 打卡 Tab -->
<view class="checkin-page">
  <!-- 地图容器 -->
  <view class="checkin-map-wrap">
    <map
      id="checkinMap"
      class="checkin-map"
      latitude="{{mapCenter.lat}}"
      longitude="{{mapCenter.lng}}"
      scale="{{mapScale}}"
      markers="{{markers}}"
      polyline="{{polylines}}"
      circles="{{circles}}"
      show-location="{{showUserLocation}}"
      bindmarkertap="onMarkerTap"
      bindregionchange="onRegionChange"
      bindtap="onMapTap"
      style="width:100%;height:100%;"
    ></map>

    <!-- 右侧工具栏 -->
    <view class="map-right-toolbar" style="top: {{statusBarHeight + 12}}px;">
      <button class="map-tool-btn" bindtap="locateUser" title="定位到我的位置">
        <text class="tool-icon">📍</text>
      </button>
      <button class="map-tool-btn" bindtap="openCheckinModal" title="添加打卡">
        <text class="tool-icon">➕</text>
      </button>
      <button class="map-tool-btn" bindtap="toggleReport" title="足迹报告">
        <text class="tool-icon">📊</text>
      </button>
    </view>

    <!-- 足迹记录控制栏 -->
    <view class="footprint-bar">
      <view class="footprint-status {{tracking ? 'tracking' : ''}}">
        <view class="fp-dot"></view>
        <text>{{tracking ? '记录中...' : '就绪'}}</text>
      </view>
      <button class="fp-track-btn {{tracking ? 'recording' : ''}}" bindtap="toggleTracking">
        <text>{{tracking ? '⏹ 停止' : '▶ 开始记录'}}</text>
      </button>
      <view class="fp-info">
        <text class="fp-count">{{footprintCount}}</text> 个足迹点
      </view>
    </view>

    <!-- 打卡列表面板 -->
    <view class="checkin-list-panel {{showList ? 'show' : ''}}">
      <view class="checkin-list-header">
        <text class="checkin-list-title">📍 打卡记录 ({{checkins.length}})</text>
        <button class="checkin-list-toggle" bindtap="toggleList">▲</button>
      </view>
      <scroll-view scroll-y class="checkin-list-scroll" wx:if="{{showList}}">
        <view class="checkin-list-empty" wx:if="{{checkins.length === 0}}">
          <text class="empty-icon">🗺️</text>
          <text class="empty-text">还没有打卡记录</text>
        </view>
        <view class="checkin-list-item" wx:for="{{checkins}}" wx:key="id" bindtap="focusCheckin" data-id="{{item.id}}">
          <image class="checkin-item-photo" src="{{item.photo}}" mode="aspectFill" wx:if="{{item.photo}}"></image>
          <view class="checkin-item-photo-placeholder" wx:else>📍</view>
          <view class="checkin-item-info">
            <view class="checkin-item-place-row">
              <text class="checkin-item-place">{{item.place}}</text>
              <text wx:if="{{item.visitCount > 1}}" class="checkin-visit-badge">第{{item.visitIndex}}次</text>
            </view>
            <text class="checkin-item-location">{{item.province}}{{item.city ? ' · ' + item.city : ''}}</text>
            <view wx:if="{{item.journeyName}}" class="checkin-journey-link">
              <text>🔗 {{item.journeyName}}</text>
              <text wx:if="{{item.dayDate}}"> · 第{{item.dayDate}}天</text>
            </view>
            <text wx:if="{{item.transport}}" class="checkin-transport">🚗 {{item.transport === 'plane' ? '✈️ 飞机' : item.transport === 'train' ? '🚄 高铁' : item.transport === 'car' ? '🚗 汽车' : item.transport === 'bus' ? '🚌 大巴' : item.transport === 'bike' ? '🚲 骑行' : item.transport === 'walk' ? '🚶 步行' : item.transport === 'ship' ? '🚢 轮船' : item.transport}}</text>
            <text class="checkin-item-time">{{item.createdAt}}</text>
          </view>
          <button class="checkin-item-delete" bindtap="deleteCheckin" data-id="{{item.id}}" catchtap="deleteCheckin">✕</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 足迹报告面板（底部滑出） -->
  <view class="report-panel {{showReport ? 'show' : ''}}" wx:if="{{showReport}}">
    <view class="report-mask" bindtap="toggleReport"></view>
    <view class="report-content">
      <!-- 拽拉手柄 -->
      <view class="report-handle">
        <view class="report-handle-bar"></view>
      </view>

      <!-- 报告头部统计 -->
      <view class="report-header">
        <text class="report-title">📊 足迹报告</text>
        <button class="report-close" bindtap="toggleReport">✕</button>
      </view>

      <!-- 核心数据卡片 -->
      <view class="report-stats-row">
        <view class="report-stat-item">
          <text class="report-stat-num">{{reportData.totalCheckins}}</text>
          <text class="report-stat-label">打卡点</text>
        </view>
        <view class="report-stat-divider"></view>
        <view class="report-stat-item">
          <text class="report-stat-num">{{reportData.cityCount}}</text>
          <text class="report-stat-label">城市</text>
        </view>
        <view class="report-stat-divider"></view>
        <view class="report-stat-item">
          <text class="report-stat-num">{{reportData.provinceLit}}/{{reportData.provinceTotal}}</text>
          <text class="report-stat-label">点亮省份</text>
        </view>
        <view class="report-stat-divider"></view>
        <view class="report-stat-item">
          <text class="report-stat-num">{{reportData.trackCount}}</text>
          <text class="report-stat-label">轨迹</text>
        </view>
      </view>

      <!-- Tab 切换 -->
      <scroll-view scroll-x class="report-tab-scroll">
        <view class="report-tab-bar">
          <text class="report-tab-item {{reportTab === 'overview' ? 'active' : ''}}" bindtap="switchReportTab" data-tab="overview">🏠 总览</text>
          <text class="report-tab-item {{reportTab === 'city' ? 'active' : ''}}" bindtap="switchReportTab" data-tab="city">🏙 城市排行</text>
          <text class="report-tab-item {{reportTab === 'province' ? 'active' : ''}}" bindtap="switchReportTab" data-tab="province">🗺 省份分布</text>
          <text class="report-tab-item {{reportTab === 'route' ? 'active' : ''}}" bindtap="switchReportTab" data-tab="route">✈ 旅行路线</text>
        </view>
      </scroll-view>

      <!-- 总览 Tab -->
      <scroll-view scroll-y class="report-body" wx:if="{{reportTab === 'overview'}}">
        <!-- 省份点亮网格 -->
        <view class="report-section-title">🗺 省份点亮</view>
        <view class="report-province-grid">
          <view class="report-prov-item {{p.lit ? 'lit' : ''}}" wx:for="{{reportData.provinceStats}}" wx:key="name">
            <text class="rprov-icon">{{p.lit ? '🔥' : '○'}}</text>
            <text class="rprov-name">{{p.name}}</text>
            <text class="rprov-count" wx:if="{{p.count > 0}}">{{p.count}}次</text>
          </view>
        </view>

        <!-- 旅行偏好 -->
        <view class="report-section-title">🎯 旅行偏好</view>
        <view class="report-pref-row">
          <view class="report-pref-card">
            <text class="rpref-icon">🏙</text>
            <text class="rpref-label">最爱城市</text>
            <text class="rpref-val">{{reportData.favCity || '暂无'}}</text>
          </view>
          <view class="report-pref-card">
            <text class="rpref-icon">🗓</text>
            <text class="rpref-label">最活跃月</text>
            <text class="rpref-val">{{reportData.favMonth || '暂无'}}</text>
          </view>
          <view class="report-pref-card">
            <text class="rpref-icon">{{reportData.favTransportIcon || '🚗'}}</text>
            <text class="rpref-label">最爱出行方式</text>
            <text class="rpref-val">{{reportData.favTransport || '暂无'}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 城市排行 Tab -->
      <scroll-view scroll-y class="report-body" wx:if="{{reportTab === 'city'}}">
        <view class="report-city-list" wx:if="{{reportData.cityStats.length > 0}}">
          <view class="rcity-item" wx:for="{{reportData.cityStats}}" wx:key="name">
            <view class="rcity-rank {{index < 3 ? 'top' + (index+1) : ''}}">
              <text>{{index + 1}}</text>
            </view>
            <text class="rcity-name">{{item.name}}</text>
            <view class="rcity-bar-wrap">
              <view class="rcity-bar-fill" style="width: {{item.pct}}%;"></view>
            </view>
            <text class="rcity-count">{{item.count}}次</text>
          </view>
        </view>
        <view class="report-empty" wx:else>
          <text>还没有数据，快去打卡吧</text>
        </view>
      </scroll-view>

      <!-- 省份分布 Tab -->
      <scroll-view scroll-y class="report-body" wx:if="{{reportTab === 'province'}}">
        <view class="report-prov-list">
          <view class="rprov-card {{item.lit ? 'lit' : ''}}" wx:for="{{reportData.provinceStatsFull}}" wx:key="name">
            <text class="rprov-card-icon">{{item.lit ? '🔥' : '○'}}</text>
            <text class="rprov-card-name">{{item.name}}</text>
            <text class="rprov-card-count" wx:if="{{item.count > 0}}">{{item.count}}次</text>
            <text class="rprov-card-building" wx:if="{{item.lit && item.building}}">{{item.building}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 旅行路线 Tab -->
      <scroll-view scroll-y class="report-body" wx:if="{{reportTab === 'route'}}">
        <view class="report-route-list" wx:if="{{reportData.flightSegments.length > 0}}">
          <view class="rroute-item" wx:for="{{reportData.flightSegments}}" wx:key="id" bindtap="focusReportSegment" data-idx="{{index}}">
            <view class="rroute-dep">
              <text class="rroute-city">{{item.fromCity}}</text>
              <text class="rroute-time">{{item.fromTime}}</text>
            </view>
            <view class="rroute-line">
              <text class="rroute-plane">{{item.transportLabel || '✈️'}}</text>
              <view class="rroute-dash"></view>
            </view>
            <view class="rroute-arr">
              <text class="rroute-city">{{item.toCity}}</text>
              <text class="rroute-time">{{item.toTime}}</text>
            </view>
          </view>
        </view>
        <view class="report-empty" wx:else>
          <text class="report-empty-icon">🛫</text>
          <text>至少需要2个打卡点才能生成旅行路线</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 打卡模态框 -->
  <view class="modal-mask {{showModal ? 'show' : ''}}" bindtap="closeModal" wx:if="{{showModal}}">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">添加打卡</text>
        <button class="modal-close" bindtap="closeModal">✕</button>
      </view>
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">地点名称 *</text>
          <input class="form-input" value="{{form.place}}" placeholder="如：天安门广场" maxlength="30" bindinput="onFieldInput" data-field="place"/>
          <text wx:if="{{placeHint}}" class="recheckin-hint">🔄 {{placeHint}}</text>
        </view>
        <view class="form-group">
          <text class="form-label">城市</text>
          <input class="form-input" value="{{form.city}}" placeholder="如：北京" maxlength="20" bindinput="onFieldInput" data-field="city"/>
        </view>
        <view class="form-group">
          <text class="form-label">省份/直辖市</text>
          <input class="form-input" value="{{form.province}}" placeholder="如：北京市" maxlength="20" bindinput="onFieldInput" data-field="province"/>
        </view>
        <!-- 交通工具 -->
        <view class="form-group">
          <text class="form-label">交通工具</text>
          <view class="transport-row">
            <view class="transport-tag {{form.transport === 'plane' ? 'active' : ''}}" bindtap="selectTransport" data-value="plane">✈️ 飞机</view>
            <view class="transport-tag {{form.transport === 'train' ? 'active' : ''}}" bindtap="selectTransport" data-value="train">🚄 高铁</view>
            <view class="transport-tag {{form.transport === 'car' ? 'active' : ''}}" bindtap="selectTransport" data-value="car">🚗 汽车</view>
            <view class="transport-tag {{form.transport === 'bus' ? 'active' : ''}}" bindtap="selectTransport" data-value="bus">🚌 大巴</view>
          </view>
          <view class="transport-row" style="margin-top:8rpx;">
            <view class="transport-tag {{form.transport === 'bike' ? 'active' : ''}}" bindtap="selectTransport" data-value="bike">🚲 骑行</view>
            <view class="transport-tag {{form.transport === 'walk' ? 'active' : ''}}" bindtap="selectTransport" data-value="walk">🚶 步行</view>
            <view class="transport-tag {{form.transport === 'ship' ? 'active' : ''}}" bindtap="selectTransport" data-value="ship">🚢 轮船</view>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">照片</text>
          <view class="photo-upload" bindtap="choosePhoto">
            <image class="photo-preview {{form.photo ? '' : 'hidden'}}" src="{{form.photo}}" mode="aspectFill" wx:if="{{form.photo}}"></image>
            <text class="photo-hint" wx:if="{{!form.photo}}">📷 点击上传照片</text>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">备注</text>
          <textarea class="form-textarea" value="{{form.note}}" placeholder="记录此刻的感受..." maxlength="200" bindinput="onFieldInput" data-field="note"/>
        </view>

        <!-- 关联旅程日志 -->
        <view class="form-group">
          <text class="form-label">🔗 关联旅程日志（可选）</text>
          <picker wx:if="{{app.globalData.appData.journeys.length > 0}}" mode="selector" range="{{app.globalData.appData.journeys}}" range-key="name" bindchange="onJourneyChange">
            <view class="picker-display">
              {{linkedJourneyId ? '已选择旅程' : '选择旅程'}}
            </view>
          </picker>
          <view wx:else class="picker-display disabled">暂无旅程</view>

          <!-- 选择具体的某一天 -->
          <picker wx:if="{{linkedDays.length > 0}}" mode="selector" range="{{linkedDays}}" range-key="title" bindchange="onDayDateChange">
            <view class="picker-display" style="margin-top:8px;">
              {{linkedDayDate || '选择具体某天（可选）'}}
            </view>
          </picker>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeModal">取消</button>
        <button class="btn-primary" bindtap="saveCheckin">打卡</button>
      </view>
    </view>
  </view>

  <!-- 自定义 TabBar -->
  <custom-tab-bar selected="{{1}}"></custom-tab-bar>

  <!-- 勋章解锁弹窗 -->
  <view class="medal-popup-mask {{showMedalPopup ? 'show' : ''}}" wx:if="{{showMedalPopup}}" bindtap="closeMedalPopup">
    <view class="medal-popup-content" catchtap="noop">
      <!-- 装饰光效 -->
      <view class="medal-glow"></view>
      <view class="medal-particles">
        <text class="particle p1">✨</text>
        <text class="particle p2">⭐</text>
        <text class="particle p3">✨</text>
        <text class="particle p4">🌟</text>
      </view>

      <!-- 勋章图标 -->
      <view class="medal-icon-wrap">
        <text class="medal-popup-icon">{{medalPopupData.icon}}</text>
      </view>

      <!-- 文字信息 -->
      <text class="medal-congrats">🎉 恭喜获得新勋章！</text>
      <text class="medal-name">「{{medalPopupData.name}}」</text>
      <text class="medal-desc">{{medalPopupData.building}}</text>
      <text class="medal-place-tip">在 {{medalPopupData.place}} 打卡点亮</text>
      <text class="medal-total-tip" wx:if="{{medalPopupData.total > 1}}">本次共解锁 {{medalPopupData.total}} 个勋章</text>

      <!-- 按钮 -->
      <view class="medal-popup-btns">
        <button class="btn-medal-know" bindtap="closeMedalPopup">太棒了</button>
        <button class="btn-medal-go" bindtap="goToMedalsFromPopup">查看全部勋章</button>
      </view>
    </view>
  </view>
</view>
