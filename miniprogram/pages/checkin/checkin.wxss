.checkin-page { width: 100%; height: 100vh; display: flex; flex-direction: column; background: var(--bg-primary); position: relative; overflow: hidden; }
.checkin-map-wrap { position: fixed; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; z-index: 0; }
.checkin-map { width: 100%; height: 100%; }
.map-right-toolbar { position: fixed; right: 20rpx; display: flex; flex-direction: column; gap: 12rpx; z-index: 10; }
.map-tool-btn { width: 72rpx; height: 72rpx; border-radius: 50%; background: #fff; box-shadow: 0 2px 12px rgba(0,0,0,0.12); display: flex; align-items: center; justify-content: center; border: none; padding: 0; margin: 0; }
.map-tool-btn::after { border: none; }
.tool-icon { font-size: 32rpx; }
.footprint-bar { position: fixed; bottom: calc(120rpx + env(safe-area-inset-bottom)); left: 20rpx; right: 20rpx; background: #fff; border-radius: 24rpx; padding: 16rpx 24rpx; display: flex; align-items: center; gap: 16rpx; box-shadow: 0 4px 24px rgba(0,0,0,0.12); z-index: 10; }
.footprint-status { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--text-muted); }
.footprint-status.tracking { color: var(--danger); }
.fp-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--text-muted); }
.footprint-status.tracking .fp-dot { background: var(--danger); animation: pulse 1.5s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
.fp-track-btn { flex: 1; padding: 12rpx 24rpx; border-radius: 16rpx; background: var(--primary); color: #fff; font-size: 24rpx; font-weight: 600; border: none; text-align: center; }
.fp-track-btn::after { border: none; }
.fp-track-btn.recording { background: var(--danger); }
.fp-info { font-size: 22rpx; color: var(--text-secondary); white-space: nowrap; }
.fp-count { font-weight: 700; color: var(--primary); }
.transport-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.transport-tag { padding: 10rpx 20rpx; border-radius: 12rpx; border: 1.5rpx solid #E5E7EB; font-size: 24rpx; color: #666; background: #fff; }
.transport-tag.active { border-color: #6366F1; background: #EEF2FF; color: #4F46E5; font-weight: 600; }
.picker-display { padding: 20rpx 24rpx; background: #F5F5F7; border-radius: 12rpx; font-size: 28rpx; color: var(--text-primary); }
.picker-display.disabled { color: var(--text-muted); }
.recheckin-hint { display: block; margin-top: 6rpx; font-size: 22rpx; color: #6366F1; }
.medal-popup-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 999; display: flex; align-items: center; justify-content: center; }
.medal-popup-content { width: 580rpx; background: linear-gradient(180deg, #FFFEF8 0%, #FFF9E6 100%); border-radius: 32rpx; padding: 60rpx 40rpx 48rpx; display: flex; flex-direction: column; align-items: center; position: relative; overflow: hidden; animation: medalPopIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes medalPopIn { 0% { transform: scale(0.6); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
.medal-icon-wrap { width: 140rpx; height: 140rpx; border-radius: 50%; background: linear-gradient(135deg, #FFD700, #FFA500); display: flex; align-items: center; justify-content: center; margin-bottom: 28rpx; box-shadow: 0 8rpx 32rpx rgba(255,165,0,0.4); }
.medal-popup-icon { font-size: 64rpx; }
.medal-congrats { font-size: 32rpx; font-weight: 800; color: #333; margin-bottom: 12rpx; }
.medal-name { font-size: 40rpx; font-weight: 900; color: #D4380D; margin-bottom: 8rpx; }
.medal-desc { font-size: 26rpx; color: #888; }
.medal-popup-btns { display: flex; gap: 20rpx; width: 100%; margin-top: 24rpx; }
.btn-medal-know { flex: 1; height: 80rpx; border-radius: 40rpx; background: #f0f0f0; color: #666; font-size: 28rpx; font-weight: 600; border: none; }
.btn-medal-know::after { border: none; }
.btn-medal-go { flex: 1.5; height: 80rpx; border-radius: 40rpx; background: linear-gradient(135deg, #FFD700, #FFA500); color: #fff; font-size: 28rpx; font-weight: 700; border: none; box-shadow: 0 4rpx 16rpx rgba(255,165,0,0.35); }
.btn-medal-go::after { border: none; }