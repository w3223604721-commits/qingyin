.share-page { min-height: 100vh; padding-bottom: 128rpx; background: var(--bg-primary); }
.page-header { padding: 32rpx 28rpx 16rpx; }
.page-title { font-size: 40rpx; font-weight: 900; color: var(--text-primary); display: block; }
.page-subtitle { font-size: 24rpx; color: var(--text-muted); margin-top: 4rpx; display: block; }
.share-tabs { display: flex; margin: 0 28rpx; background: var(--bg-secondary); border-radius: 16rpx; padding: 6rpx; }
.share-tab { flex: 1; padding: 14rpx; text-align: center; font-size: 26rpx; color: var(--text-secondary); background: none; border: none; border-radius: 12rpx; font-weight: 500; }
.share-tab::after { border: none; }
.share-tab.active { background: #fff; color: var(--primary); font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
.share-panel { padding: 20rpx 28rpx; }
.share-section-title { font-size: 26rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 16rpx; }
.share-journey-list { display: flex; flex-direction: column; gap: 16rpx; }
.share-card { background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
.share-card-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.share-card-name { font-size: 32rpx; font-weight: 800; color: var(--text-primary); }
.share-card-badge { font-size: 20rpx; background: var(--primary-bg); color: var(--primary); padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: 600; }
.share-card-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 8rpx; }
.meta-item { font-size: 22rpx; color: var(--text-secondary); }
.share-card-thumbs { display: flex; gap: 8rpx; margin-bottom: 16rpx; }
.share-thumb { width: 100rpx; height: 100rpx; border-radius: 10rpx; background: var(--bg-secondary); }
.share-thumb-more { display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--text-muted); background: var(--bg-tertiary); }
.share-card-footer { display: flex; gap: 16rpx; }
.share-action { flex: 1; padding: 16rpx; border-radius: 14rpx; font-size: 24rpx; font-weight: 600; text-align: center; border: none; }
.share-action::after { border: none; }
.export-action { background: var(--primary-bg); color: var(--primary); }
.receipt-action { background: var(--bg-secondary); color: var(--text-primary); }
.template-style-selector { margin-bottom: 24rpx; }
.template-style-title { font-size: 26rpx; font-weight: 700; color: var(--text-primary); display: block; margin-bottom: 12rpx; }
.template-style-list { display: flex; gap: 12rpx; }
.template-style-card { flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx 12rpx; text-align: center; border: 2rpx solid transparent; }
.template-style-card.active { border-color: var(--primary); background: var(--primary-bg); }
.template-preview { font-size: 40rpx; display: block; margin-bottom: 6rpx; }
.template-name { font-size: 22rpx; font-weight: 600; color: var(--text-primary); }
.template-badge { font-size: 18rpx; color: var(--text-muted); display: block; }
.template-custom-editor { background: #fff; border-radius: 20rpx; padding: 24rpx; }
.editor-section-title { font-size: 28rpx; font-weight: 800; color: var(--text-primary); margin-bottom: 16rpx; display: block; }
.add-photo-btn { width: 100%; padding: 20rpx; margin-top: 12rpx; border: 2rpx dashed var(--border); border-radius: 14rpx; background: none; color: var(--text-muted); font-size: 26rpx; text-align: center; }
.add-photo-btn::after { border: none; }
.photo-count-hint { font-size: 22rpx; color: var(--text-muted); display: block; text-align: center; margin-top: 6rpx; }
.btn-block { width: 100%; margin-top: 16rpx; }