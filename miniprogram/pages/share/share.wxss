.share-page {
  min-height: 100vh;
  padding-bottom: 128rpx;
  background: var(--bg-primary);
}

.page-header {
  padding: 32rpx 28rpx 16rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text-primary);
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  display: block;
}

/* 分享Tab切换 */
.share-tabs {
  display: flex;
  margin: 0 28rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 6rpx;
}

.share-tab {
  flex: 1;
  padding: 14rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: none;
  border: none;
  border-radius: 12rpx;
  font-weight: 500;
}

.share-tab::after { border: none; }

.share-tab.active {
  background: #fff;
  color: var(--primary);
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

/* 分享面板 */
.share-panel {
  padding: 20rpx 28rpx;
}

.share-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

/* 分享旅程卡片 */
.share-journey-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.share-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

.share-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.share-card-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.share-card-badge {
  font-size: 20rpx;
  background: var(--primary-bg);
  color: var(--primary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.share-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.share-card-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.share-card-thumbs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.share-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: var(--bg-secondary);
}

.share-thumb-more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-muted);
  background: var(--bg-tertiary);
}

.share-card-footer {
  display: flex;
  gap: 16rpx;
}

.share-action {
  flex: 1;
  padding: 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.share-action::after { border: none; }

.export-action {
  background: var(--primary-bg);
  color: var(--primary);
}

.receipt-action {
  background: var(--bg-secondary);
  color: var(--text-primary);
}

/* 模板风格选择 */
.template-style-selector {
  margin-bottom: 24rpx;
}

.template-style-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.template-style-list {
  display: flex;
  gap: 12rpx;
}

.template-style-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
  position: relative;
}

.template-style-card.active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.template-preview {
  font-size: 40rpx;
  display: block;
  margin-bottom: 6rpx;
}

.template-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.template-badge {
  font-size: 18rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 2rpx;
}

/* 自定义编辑器 */
.template-custom-editor {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.editor-section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.tpl-photo-area {
  margin-top: 8rpx;
}

.tpl-photo-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tpl-photo-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: var(--bg-secondary);
  border-radius: 14rpx;
  padding: 12rpx;
  position: relative;
}

.tpl-photo-img {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  background: var(--bg-tertiary);
}

.tpl-photo-remove {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tpl-photo-remove::after { border: none; }

.tpl-photo-text {
  font-size: 24rpx;
  color: var(--text-primary);
  padding: 12rpx;
  background: #fff;
  border-radius: 10rpx;
}

.tpl-photo-meta {
  display: flex;
  gap: 12rpx;
}

.tpl-photo-place {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-secondary);
  padding: 10rpx 12rpx;
  background: #fff;
  border-radius: 10rpx;
}

.tpl-photo-date {
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 10rpx 12rpx;
  background: #fff;
  border-radius: 10rpx;
}

.add-photo-btn {
  width: 100%;
  padding: 20rpx;
  margin-top: 12rpx;
  border: 2rpx dashed var(--border);
  border-radius: 14rpx;
  background: none;
  color: var(--text-muted);
  font-size: 26rpx;
  text-align: center;
}

.add-photo-btn::after { border: none; }

.photo-count-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  text-align: center;
  margin-top: 6rpx;
}

.btn-block {
  width: 100%;
  margin-top: 16rpx;
}

/* 小票弹窗 */
.receipt-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.receipt-container {
  width: 640rpx;
  max-height: 90vh;
  background: var(--receipt-bg, #FFFAF0);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.receipt-scroll {
  max-height: 70vh;
  padding: 32rpx 24rpx;
}

.receipt-paper {
  font-family: 'Courier New', monospace;
  color: var(--receipt-text, #2D1810);
}

.receipt-header {
  text-align: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed var(--receipt-accent, #D4A574);
}

.receipt-logo {
  font-size: 20rpx;
  color: var(--receipt-accent, #D4A574);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.receipt-title {
  font-size: 36rpx;
  font-weight: 900;
  margin-top: 8rpx;
  display: block;
}

.receipt-body {
  margin-bottom: 20rpx;
}

.receipt-journey-info {
  margin-bottom: 16rpx;
}

.rct-place {
  font-size: 26rpx;
  font-weight: 700;
  display: block;
}

.rct-date-range {
  font-size: 22rpx;
  color: var(--receipt-accent, #D4A574);
}

.receipt-photo-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--receipt-accent, #D4A574);
}

.rp-photo-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.rp-photo {
  width: 100%;
  height: 100%;
}

.rp-photo-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.rp-photo-time {
  font-size: 20rpx;
  color: var(--receipt-accent, #D4A574);
}

.rp-photo-title {
  font-size: 28rpx;
  font-weight: 800;
  margin: 4rpx 0;
}

.rp-photo-desc {
  font-size: 22rpx;
  color: var(--receipt-muted, #8B7355);
}

.receipt-footer-note {
  text-align: center;
  font-size: 20rpx;
  color: var(--receipt-muted, #8B7355);
  padding: 20rpx 0;
  font-style: italic;
}

.receipt-footer-custom {
  text-align: center;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--receipt-accent, #D4A574);
}

.receipt-barcode {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--receipt-text, #2D1810);
  margin-bottom: 8rpx;
}

.receipt-thanks {
  font-size: 18rpx;
  color: var(--receipt-accent, #D4A574);
  letter-spacing: 2rpx;
}

.receipt-actions {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--border);
}

.share-btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.share-btn::after { border: none; }

.receipt-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  color: #fff;
  font-size: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.receipt-close::after { border: none; }
