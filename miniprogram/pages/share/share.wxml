<view class="share-page">
  <view class="page-header"><text class="page-title">🧾 旅程分享</text><text class="page-subtitle">导出旅行记忆，分享精彩时刻</text></view>
  <view class="share-tabs">
    <button class="share-tab {{activeTab === 'export' ? 'active' : ''}}" bindtap="switchTab" data-tab="export">日志导出</button>
    <button class="share-tab {{activeTab === 'template' ? 'active' : ''}}" bindtap="switchTab" data-tab="template">自定义模板</button>
  </view>
  <view class="share-panel" wx:if="{{activeTab === 'export'}}">
    <view class="share-section-title">选择要导出的旅程</view>
    <view class="share-journey-list">
      <view class="empty-state" wx:if="{{journeys.length === 0}}"><text class="empty-icon">🎫</text><text class="empty-text">还没有可分享的旅程</text></view>
      <view class="share-card" wx:for="{{journeys}}" wx:key="id">
        <view class="share-card-header"><text class="share-card-name">{{item.name}}</text><text class="share-card-badge" wx:if="{{item.city}}">{{item.city}}</text></view>
        <view class="share-card-body">
          <view class="share-card-meta"><text class="meta-item">📅 {{item.dateRange || '未设置日期'}}</text><text class="meta-item">📝 {{item.dayCount}}天日记</text><text class="meta-item">📍 {{item.checkinCount}}打卡</text><text class="meta-item">📷 {{item.photoCount}}照片</text></view>
          <text class="share-card-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          <view class="share-card-thumbs" wx:if="{{item.thumbs.length > 0}}">
            <image class="share-thumb" wx:for="{{item.thumbs}}" wx:for-item="thumb" wx:key="*this" src="{{thumb}}" mode="aspectFill"></image>
            <view class="share-thumb share-thumb-more" wx:if="{{item.moreCount > 0}}">+{{item.moreCount}}</view>
          </view>
        </view>
        <view class="share-card-footer">
          <button class="share-action export-action" bindtap="exportJourney" data-id="{{item.id}}"><text>📥 导出图片</text></button>
          <button class="share-action receipt-action" bindtap="openReceipt" data-id="{{item.id}}"><text>🧾 小票分享</text></button>
        </view>
      </view>
    </view>
  </view>
  <view class="share-panel" wx:if="{{activeTab === 'template'}}">
    <view class="template-style-selector">
      <text class="template-style-title">选择分享风格</text>
      <view class="template-style-list">
        <view class="template-style-card {{tplStyle === 'receipt' ? 'active' : ''}}" bindtap="selectStyle" data-style="receipt"><text class="template-preview">🧾</text><text class="template-name">小票风格</text></view>
        <view class="template-style-card" bindtap="selectStyle" data-style="card"><text class="template-preview">🎴</text><text class="template-name">卡片风格</text><text class="template-badge">即将上线</text></view>
        <view class="template-style-card" bindtap="selectStyle" data-style="timeline"><text class="template-preview">📅</text><text class="template-name">时间线</text><text class="template-badge">即将上线</text></view>
        <view class="template-style-card" bindtap="selectStyle" data-style="magazine"><text class="template-preview">📰</text><text class="template-name">杂志风</text><text class="template-badge">即将上线</text></view>
      </view>
    </view>
    <view class="template-custom-editor">
      <text class="editor-section-title">自定义内容</text>
      <view class="form-group"><text class="form-label">分享标题</text><input class="form-input" value="{{tplTitle}}" placeholder="如：这一段生活的小票" maxlength="30" bindinput="onTplTitleInput"/></view>
      <view class="form-group"><text class="form-label">选择图片 (2-9张)</text>
        <view class="tpl-photo-area"><button class="add-photo-btn" bindtap="addTplPhoto" wx:if="{{tplPhotos.length < 9}}">＋ 添加图片</button><text class="photo-count-hint">{{tplPhotos.length}}/9 张</text></view>
      </view>
      <button class="btn-primary btn-block" bindtap="generateReceipt">生成预览</button>
    </view>
  </view>
  <custom-tab-bar selected="{{2}}"></custom-tab-bar>
</view>