.detail-nav {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}
.detail-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 轮播 */
.carousel-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: #1a1a2e;
  position: relative;
}
.carousel-swiper {
  height: 480rpx;
}
.carousel-img {
  width: 100%;
  height: 100%;
}
.carousel-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 24rpx 24rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  color: #fff;
  font-size: 26rpx;
}
.carousel-counter {
  position: absolute;
  bottom: 16rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  z-index: 5;
  pointer-events: none;
}
.carousel-empty {
  height: 200rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* 日记列表 */
.day-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 24rpx 0;
}
.day-card {
  background: var(--bg-primary);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 28rpx;
  position: relative;
}
.day-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.day-date {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}
.day-delete {
  font-size: 28rpx;
  padding: 8rpx;
}
.day-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  display: block;
}
.day-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
.day-photos {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.day-photo-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  background: var(--bg-tertiary);
}
.day-photo-more {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 700;
}

.btn-add-day {
  width: 100%;
  padding: 24rpx;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
