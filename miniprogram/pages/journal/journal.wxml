<view class="page-container">
  <view class="page-header" style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;">
    <view><text class="page-header-title">📖 我的旅程</text><text class="page-header-sub">记录每一段旅程</text></view>
  </view>
  <view class="search-bar-wrap">
    <view class="search-bar"><text class="search-icon">🔍</text><input class="search-input" value="{{searchQuery}}" placeholder="搜索旅程名称、城市..." bindinput="onSearchInput" confirm-type="search"/><text wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch">✕</text></view>
  </view>
  <view wx:if="{{filteredJourneys.length === 0 && journeys.length > 0}}" class="empty-state"><text class="empty-icon">🔍</text><text class="empty-title">未找到匹配的旅程</text><text class="empty-desc">尝试更换关键词</text></view>
  <view wx:elif="{{journeys.length === 0}}" class="empty-state"><text class="empty-icon">🗺️</text><text class="empty-title">还没有旅程记录</text><text class="empty-desc">点击右下角 + 开启你的第一段旅程吧</text></view>
  <view wx:else class="journal-list">
    <view wx:for="{{filteredJourneys}}" wx:key="id" class="journey-card {{item.coverPhoto ? 'has-cover' : ''}}" bindtap="goDetail" data-id="{{item.id}}">
      <image wx:if="{{item.coverPhoto}}" class="journey-cover" src="{{item.coverPhoto}}" mode="aspectFill" />
      <view class="journey-card-body">
        <view class="journey-card-header"><text class="journey-name">{{item.name}}</text><view class="journey-menu" catchtap="showMenu" data-id="{{item.id}}">⋯</view></view>
        <view class="journey-meta"><text>{{app.formatDateRange(item.startDate, item.endDate)}}</text><text wx:if="{{item.days.length}}"> · {{item.days.length}} 天</text></view>
        <text wx:if="{{item.desc}}" class="journey-desc">{{item.desc}}</text>
        <view wx:if="{{item.city}}" class="journey-tags"><text wx:for="{{item.city.split(',')}}" wx:key="*this" wx:if="{{item}}" class="tag">{{item.trim()}}</text></view>
      </view>
    </view>
  </view>
  <button class="fab" bindtap="openCreate" hover-class="fab-hover">＋</button>
</view>
<custom-tab-bar selected="{{0}}" />