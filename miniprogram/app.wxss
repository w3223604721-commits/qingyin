/* 轻印旅行记忆 v2.0 全局样式 */
page {
  --primary: #6366F1;
  --primary-light: #A5B4FC;
  --primary-bg: #EEF2FF;
  --primary-dark: #4F46E5;
  --success: #10B981;
  --success-bg: #D1FAE5;
  --warning: #F59E0B;
  --warning-bg: #FEF3C7;
  --danger: #EF4444;
  --danger-bg: #FEE2E2;
  --orange: #F97316;
  --pink: #EC4899;
  --text-primary: #1E293B;
  --text-secondary: #64748B;
  --text-muted: #94A3B8;
  --border: #E2E8F0;
  --bg-primary: #FFFFFF;
  --bg-secondary: #F8FAFC;
  --bg-tertiary: #F1F5F9;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
  --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.07);
  --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --bottom-nav-h: 128rpx;

  /* 小票 */
  --receipt-bg: #FFFAF0;
  --receipt-text: #2D1810;
  --receipt-muted: #8B7355;
  --receipt-border: #D4C5A9;
  --receipt-line: #E8DCC8;

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-secondary);
  box-sizing: border-box;
  line-height: 1.6;
}

/* ====== 页面容器 ====== */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  padding-bottom: calc(var(--bottom-nav-h) + 100rpx);
}

/* ====== 页面头部 ====== */
.page-header {
  margin-bottom: 32rpx;
}
.page-header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.page-header-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* ====== 卡片 ====== */
.card {
  background: var(--bg-primary);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

/* ====== 按钮 ====== */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-primary:active { background: var(--primary-dark); }
.btn-secondary {
  background: var(--bg-tertiary);
  color: var(--text-primary);
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 40rpx;
  padding: 18rpx 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-block { width: 100%; }
.btn-sm { padding: 12rpx 28rpx; font-size: 24rpx; }

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; opacity: 0.6; }
.empty-title { font-size: 32rpx; font-weight: 700; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: var(--text-muted); line-height: 1.6; }

/* ====== FAB ====== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(var(--bottom-nav-h) + 48rpx);
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.4);
  z-index: 999;
  border: none;
  line-height: 1;
  padding: 0;
  margin: 0;
}
.fab::after { border: none; }
.fab-hover { transform: scale(0.95); opacity: 0.9; }

/* ====== 模态框 ====== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  background: var(--bg-primary);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
  position: sticky;
  top: 0;
  background: var(--bg-primary);
  z-index: 1;
}
.modal-title { font-size: 32rpx; font-weight: 700; }
.modal-close {
  font-size: 40rpx;
  color: var(--text-muted);
  padding: 8rpx 16rpx;
}
.modal-footer {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  padding-top: 24rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--border);
  position: sticky;
  bottom: 0;
  background: var(--bg-primary);
}

/* ====== 表单 ====== */
.form-group { margin-bottom: 24rpx; }
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  display: block;
}
.form-input, .form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-secondary);
  box-sizing: border-box;
}
.form-textarea { min-height: 160rpx; }
.form-input:focus, .form-textarea:focus {
  border-color: var(--primary-light);
  background: var(--bg-primary);
}
.form-row { display: flex; gap: 16rpx; }
.form-row .form-group { flex: 1; }

/* ====== 照片 ====== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.photo-item {
  width: 156rpx;
  height: 156rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  position: relative;
  background: var(--bg-tertiary);
}
.photo-item image {
  width: 100%;
  height: 100%;
}
.photo-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.55);
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.photo-add {
  width: 156rpx;
  height: 156rpx;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 24rpx;
  background: var(--bg-primary);
}
.photo-add-icon { font-size: 48rpx; }

/* ====== 标签 ====== */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--primary-bg);
  color: var(--primary);
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

/* ====== 统计卡片 ====== */
.stats-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  flex: 1;
  background: var(--bg-primary);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 24rpx 12rpx;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1.2;
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* ====== Toast ====== */
.toast {
  position: fixed;
  top: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  background: var(--text-primary);
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  z-index: 9999;
  box-shadow: var(--shadow-lg);
}

/* ====== 返回按钮 ====== */
.btn-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
}
.btn-back:active { background: var(--primary-bg); }

/* ====== 菜单箭头 ====== */
.menu-arrow { font-size: 40rpx; color: var(--text-muted); }
